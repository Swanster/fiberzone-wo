# Fiberzone WO Dashboard — environment
# Salin ke .env dan sesuaikan bila perlu. v1 tidak membaca .env secara otomatis;
# variabel dibaca langsung dari environment process (uvicorn/cli).

# Lokasi database SQLite (default: data/wo.db relatif ke root repo)
FZWO_DB=data/wo.db

# Host & port uvicorn
FZWO_HOST=0.0.0.0
FZWO_PORT=8600
